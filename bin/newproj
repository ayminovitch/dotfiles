#!/bin/bash
# newproj: start a new Python/AI project from templates/ai-project.
#
#   newproj rag-chatbot             creates $NEWPROJ_DIR/rag-chatbot (default ~/Projects)
#   newproj rag-chatbot ~/code      creates ~/code/rag-chatbot
set -euo pipefail

TEMPLATE="${DOTFILES:-$HOME/dotfiles}/templates/ai-project"

die()  { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
info() { printf '\033[36m→ %s\033[0m\n' "$*"; }
warn() { printf '\033[33m! %s\033[0m\n' "$*"; }

[ $# -ge 1 ] || die "usage: newproj <name> [parent-folder]"
name="$1"
parent="${2:-${NEWPROJ_DIR:-${CODE_DIR:-$HOME/Projects}}}"
[[ "$name" =~ ^[a-z][a-z0-9-]*$ ]] || die "use lowercase letters, digits and dashes, e.g. rag-chatbot"
[ -d "$TEMPLATE" ] || die "template not found: $TEMPLATE"
command -v uv >/dev/null || die "uv is missing (brew install uv)"

pkg="${name//-/_}"
dest="$parent/$name"
[ -e "$dest" ] && die "$dest already exists"

info "Creating $dest"
mkdir -p "$parent"
cp -R "$TEMPLATE" "$dest"

# The template keeps dotfiles as dot-* so they don't affect this repo. Rename them back.
find "$dest" -depth -name 'dot-*' | while IFS= read -r f; do
  mv "$f" "$(dirname "$f")/.${f##*/dot-}"
done
mv "$dest/src/__PKG__" "$dest/src/$pkg"
grep -rl --null -e '__PROJECT__' -e '__PKG__' "$dest" | xargs -0 perl -pi -e "s/__PROJECT__/$name/g; s/__PKG__/$pkg/g"

cd "$dest"
cp .env.example .env
command -v direnv >/dev/null && direnv allow . >/dev/null 2>&1   # .envrc pulls API keys from the Keychain

info "Installing dependencies"
uv sync --quiet

info "Setting up git and pre-commit"
git init -q
uv run --quiet pre-commit install >/dev/null
if ! command -v gitleaks >/dev/null; then
  warn "gitleaks isn't installed (brew install gitleaks), skipping the secret scan for now"
  export SKIP=gitleaks-system
fi
git add -A
uv run --quiet pre-commit run --all-files >/dev/null 2>&1 || true   # first run installs hooks and auto-fixes
git add -A
if commit_out="$(git commit -q -m "chore: scaffold $name" 2>&1)"; then
  info "First commit done"
else
  warn "Couldn't make the first commit (files are staged):"
  printf '%s\n' "$commit_out" | tail -5
fi

info "Running checks"
uv run ruff check . --quiet && uv run mypy src --no-error-summary && uv run pytest -q

cat <<EOF

✓ $name is ready in $dest

  cd $dest
  charm .       open it in PyCharm (or code . for VS Code)
  just dev      API on http://localhost:8000/docs
  just db       Postgres + pgvector
  claude        or gemini, both read AGENTS.md

API keys: secret set GROQ_API_KEY (stored in the Keychain, .envrc loads them)
Push it:  gh repo create $name --private --source . --push
EOF
