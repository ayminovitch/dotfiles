#!/bin/bash
# secret: keep API keys in the macOS Keychain instead of .env files.
#
#   secret set GROQ_API_KEY     add or replace a key (macOS prompts for it, nothing hits history)
#   secret list                 names of the keys you have
#   secret get GROQ_API_KEY     print one, for scripts
#   secret rm GROQ_API_KEY      delete one
#   secret env NAME...          export lines for direnv. In a project's .envrc:
#                                 eval "$(secret env GROQ_API_KEY GEMINI_API_KEY)"
#
# They're stored in your login Keychain as "dotfiles: NAME". That keeps keys out of files malware
# sweeps up, out of git, and away from coding agents (their sandboxes strip these variables).
# It won't stop malware that's already running as you, since that can ask the Keychain too.
set -euo pipefail

PREFIX="dotfiles: "
ACCOUNT="${USER:-$(id -un)}"
die()  { printf 'secret: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
check_name() { [[ "${1:-}" =~ ^[A-Z_][A-Z0-9_]*$ ]] || die "use a name like ANTHROPIC_API_KEY (capitals, digits, _)"; }
command -v security >/dev/null || die "the macOS 'security' tool is missing, this only works on a Mac"

get() { security find-generic-password -a "$ACCOUNT" -s "$PREFIX$1" -w 2>/dev/null; }

case "${1:-}" in
  set)
    check_name "${2:-}"
    # -w at the end makes macOS prompt for the value, so it never appears in your shell history
    # or in the process list. -U replaces an existing key with the same name.
    security add-generic-password -U -a "$ACCOUNT" -s "$PREFIX$2" -l "$PREFIX$2" \
      -D "API key (dotfiles)" -w
    printf 'Saved %s in your Keychain.\n' "$2"
    ;;
  get)
    check_name "${2:-}"
    get "$2" || die "$2 isn't in your Keychain (add it: secret set $2)"
    ;;
  list)
    security dump-keychain 2>/dev/null \
      | sed -n "s/^.*\"svce\"<blob>=\"$PREFIX\(.*\)\"\$/\1/p" | sort -u
    ;;
  rm)
    check_name "${2:-}"
    security delete-generic-password -a "$ACCOUNT" -s "$PREFIX$2" >/dev/null 2>&1 \
      || die "$2 isn't in your Keychain"
    printf 'Removed %s from your Keychain.\n' "$2"
    ;;
  env)
    shift
    for name in "$@"; do
      check_name "$name"
      if value="$(get "$name")"; then printf 'export %s=%q\n' "$name" "$value"; fi
    done
    ;;
  -h|--help|help) usage ;;
  *) usage 1 ;;
esac
